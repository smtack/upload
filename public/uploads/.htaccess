<IfModule mod_rewrite.c>
    RewriteEngine On

    Options -Indexes
    Options -MultiViews
</IfModule>

# Disable script execution in the uploads directory

<FilesMatch "\.(php|phtml|php3|php4|php5|php6|php7|phar|pl|py|cgi)$">
    Require all denied
</FilesMatch>

# This forces the browser to download the file instead of running it.

<IfModule mod_mime.c>
    AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .php7 .phar .pl .py .cgi
</IfModule>
